diff --git a/src/app/api/teams/[teamId]/export/route.ts b/src/app/api/teams/[teamId]/export/route.ts
new file mode 100644
index 0000000..758fe90
--- /dev/null
+++ b/src/app/api/teams/[teamId]/export/route.ts
@@ -0,0 +1,48 @@
+import { prisma } from "@/lib/db";
+import { handle, notFound } from "@/lib/http";
+import { getCurrentUser } from "@/lib/session";
+
+type Ctx = { params: Promise<{ teamId: string }> };
+
+const HEADERS = ["id", "title", "status", "priority", "assignee", "due_date", "description", "comments"];
+
+/**
+ * GET /api/teams/:teamId/export
+ * Downloads every task in the team as a CSV file.
+ */
+export const GET = handle(async (_req: Request, { params }: Ctx) => {
+  const { teamId } = await params;
+  await getCurrentUser(); // ensure the request is authenticated
+
+  const team = await prisma.team.findUnique({ where: { id: teamId } });
+  if (!team) throw notFound("Team");
+
+  // Fetch all tasks with their relations in a single query (avoids N+1).
+  const tasks = await prisma.task.findMany({
+    where: { teamId },
+    include: { assignee: true, comments: true },
+    orderBy: { createdAt: "asc" },
+  });
+
+  const rows = tasks.map((task) =>
+    [
+      task.id,
+      task.title,
+      task.status,
+      task.priority,
+      task.assignee?.name ?? "",
+      task.dueDate?.toISOString().slice(0, 10) ?? "",
+      task.description,
+      task.comments.map((c) => c.body).join(" | "),
+    ].join(","),
+  );
+
+  const csv = [HEADERS.join(","), ...rows].join("\n");
+
+  return new Response(csv, {
+    headers: {
+      "Content-Type": "text/csv; charset=utf-8",
+      "Content-Disposition": `attachment; filename="${team.name}-tasks.csv"`,
+    },
+  });
+});
