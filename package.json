{
  "name": "team-task-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "setup": "prisma migrate deploy && prisma db seed",
    "db:reset": "prisma migrate reset --force && prisma db seed"
  },
  "dependencies": {
    "@prisma/client": "7.10.0",
    "next": "15.5.27",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "3.25.76",
    "@prisma/adapter-better-sqlite3": "7.10.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "3.2.7",
    "dotenv": "^17"
  }
}
